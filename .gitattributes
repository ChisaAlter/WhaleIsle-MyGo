# Normalize line endings: text files are LF in the repository.
* text=auto

# Scripts and platform-specific text files
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.nsi text eol=lf
*.nsh text eol=lf
*.go text eol=lf

# Images and media
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bmp binary
*.avif binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary

# Archives and binaries
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.7z binary
*.exe binary
*.dll binary
*.dylib binary
*.so binary
*.syso binary

# Preserve vendored mobile Git source bytes and recorded provenance hashes.
internal/desktop/phoneremote/git-source/** -text

# The Whale UI viewers are embedded byte-for-byte and pinned by sha256 in
# provenance.json, so a checkout that rewrote their line endings would neither
# reproduce the pins nor admit the embedded viewer at runtime.
internal/desktop/openui/viewer/** -text

# The offline MathJax bundle is embedded byte-for-byte; keep its recorded LF
# bytes intact even when the host checkout has autocrlf enabled.
internal/mathrender/renderer.cjs text eol=lf
