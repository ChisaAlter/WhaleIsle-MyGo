    "chat": {
      "fixture": "fixtures/chat-basic.json",
      "scenarios": [
        {
          "id": "chat-open",
          "domDump": "[data-conversation-scroll]",
          "web": {
            "setup": [
              {
                "dismiss": [
                  {
                    "selector": "[role=dialog] button[aria-label='关闭']"
                  },
                  {
                    "selector": "[role=dialog] button[class*=_primary]"
                  },
                  {
                    "within": "[role=dialog]",
                    "text": "继续"
                  }
                ],
                "gone": "[role=dialog]",
                "optional": true
              }
            ],
            "steps": [
              {
                "click": {
                  "within": "div[role=tree]",
                  "text": [
                    "奇偶校验基准会话",
                    "未命名"
                  ],
                  "upTo": "[role=treeitem]"
                }
              }
            ]
          },
          "native": {
            "steps": [
              {
                "invoke": {
                  "namePrefix": "奇偶校验基准会话",
                  "type": "Button"
                }
              }
            ]
          },
          "landmarks": [
            {
              "key": "sidebar.fixture-session",
