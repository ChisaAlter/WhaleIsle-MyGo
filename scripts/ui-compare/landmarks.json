{
  "version": 2,
  "surfaces": {
    "workbench": {
      "scenarios": [
        {
          "id": "empty-workbench",
          "web": {
            "setup": [
              {
                "dismiss": [
                  {
                    "selector": "[role=dialog] button[aria-label='关闭']"
                  },
                  {
                    "selector": "[role=dialog] button[class*=_primary]"
                  },
                  {
                    "within": "[role=dialog]",
                    "text": "继续"
                  }
                ],
                "gone": "[role=dialog]",
                "optional": true
              }
            ],
            "steps": []
          },
          "native": {
            "steps": []
          },
          "landmarks": [
            {
              "key": "sidebar.brand",
              "web": {
                "selector": "button[class*=_brand]"
              },
              "native": {
                "name": "鲸屿 MyGo",
                "type": "Button"
              },
              "assert": [
                "w",
                "h"
              ]
            },
            {
              "key": "sidebar.new-chat",
              "web": {
                "selector": "button[class*=_newSession]"
              },
              "native": {
                "name": "新会话",
                "type": "Button",
                "index": 0
              },
              "assert": [
                "h",
                "dy-prev"
              ]
            },
            {
              "key": "sidebar.nav-plugins",
              "web": {
                "selector": "button[aria-label='插件']"
              },
              "native": {
                "name": "插件",
                "type": "Button"
              },
              "assert": [
                "h",
                "dy-prev"
              ]
            },
            {
