# Go toolchain, module and build caches (regenerate with scripts/env.ps1)
.toolchain/
.gocache/

# Built harness runtime + node_modules; rebuild with scripts/build-harness.ps1
# (sources are copied from the reference snapshot, see reference/README.md)
runtime/
/runtime-rc4/

# Read-only snapshot of the original Electron app (regenerate per reference/README.md)
reference/electron/

# Build output
dist/
dist-release/
*.exe
*.log
*.syso

# Verified THA4 runtime is staged locally, never checked in.
pet-render-assets/

# Local MyGo dev instance: its private data dir (WHALEISLE_USER_DATA, holds a
# copy of credentials.json) and the runtime staged for it by
# scripts/session-runtime.mjs. Never committed.
.devdata/
.devdata-clean/
.runtime-rc2/

# Scratch notes, logs and one-off helper scripts.
/tmp/*
!/tmp/go.mod

# Runtime files the packaging stage copies next to the built shell.
/ghostty-vt.dll
/ghostty-vt.dll.LICENSE
/terminal-runtime.json

/bin/
